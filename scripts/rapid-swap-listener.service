[Unit]
Description=Rapid Swap WebSocket Listener
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/boonetools-backend/current
ExecStart=/usr/bin/node scripts/rapid-swap-listener.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# Load secrets from env file
EnvironmentFile=/opt/boonetools-backend/config/backend.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rapid-swap-listener

[Install]
WantedBy=multi-user.target
