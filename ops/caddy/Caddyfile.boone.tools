themememap.com {
    reverse_proxy localhost:8080
}

www.themememap.com {
    redir https://themememap.com{uri} permanent
}

boonewheeler.com, www.boonewheeler.com {
    handle_path /boonetools/* {
        redir https://boone.tools{uri} permanent
    }
    handle /boonetools {
        redir https://boone.tools/ permanent
    }
    handle {
        redir https://boonewheeler.com/boonetools/ permanent
    }
}

boone.tools {
    encode zstd gzip

    route {
        handle_path /functions/v1/* {
            reverse_proxy 127.0.0.1:8787
        }

        @private_thorstore path /store /store/* /merch /merch/* /thorstore /thorstore/* /ThorStore /ThorStore/*
        respond @private_thorstore 404

        @static_assets path /assets/* /data/* /favicon.ico /favicon-192.png /favicon-512.png /apple-touch-icon.png /_redirects /ip-info.json /tcy_claims.json
        handle @static_assets {
            root * /var/www/boone-tools
            file_server
        }

        handle {
            root * /var/www/boone-tools
            try_files {path} /index.html
            file_server
        }
    }
}

www.boone.tools {
    redir https://boone.tools{uri} permanent
}
