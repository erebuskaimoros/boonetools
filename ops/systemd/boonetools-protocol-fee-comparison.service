[Unit]
Description=BooneTools monthly protocol fee comparison collector
After=network-online.target docker.service boonetools-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/boonetools-backend/current/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/config/backend.env
ExecStart=/usr/bin/node src/run-job.js protocol-fee-comparison
TimeoutStartSec=30m
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-protocol-fee-comparison
