[Unit]
Description=BooneTools Rujira Reserve Payment WebSocket Listener
After=network-online.target docker.service boonetools-api.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/boonetools-backend/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/backend/.env
ExecStart=/usr/bin/node src/rujira-reserve-listener.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-rujira-reserve-listener

[Install]
WantedBy=multi-user.target
