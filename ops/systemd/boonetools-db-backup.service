[Unit]
Description=BooneTools Postgres Backup
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/opt/boonetools-backend/config/backend.env
ExecStart=/usr/bin/bash /opt/boonetools-backend/current/scripts/boonetools-db-backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-db-backup
