[Unit]
Description=BooneTools Compact Live Status Read Model Scheduler
After=network-online.target docker.service boonetools-api.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/boonetools-backend/current/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/config/backend.env
ExecStart=/usr/bin/node src/run-job.js status-live-scheduler
TimeoutStartSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-status-live
