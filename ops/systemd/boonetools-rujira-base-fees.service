[Unit]
Description=BooneTools Rujira Base Fees Scheduler
After=network-online.target docker.service boonetools-api.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/boonetools-backend/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/backend/.env
ExecStart=/usr/bin/node src/run-job.js rujira-base-fees-scheduler
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-rujira-base-fees
