[Unit]
Description=BooneTools System Income POL Reconciliation
After=network-online.target docker.service boonetools-api.service boonetools-chain-stream-listener.service boonetools-thornode-core-snapshot.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/boonetools-backend/current/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/config/backend.env
ExecStart=/usr/bin/node src/run-job.js system-income-pol-scheduler
TimeoutStartSec=15m
Restart=on-failure
RestartSec=2m
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-system-income-pol
