[Unit]
Description=Build BooneTools Rapid Swaps market-history read model
After=network-online.target docker.service boonetools-api.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/boonetools-backend/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/backend/.env
ExecStart=/usr/bin/node src/run-job.js rapid-swaps-market-history
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-rapid-swaps-market-history
