[Unit]
Description=BooneTools Consolidated THORChain WebSocket Listener
After=network-online.target docker.service boonetools-api.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/boonetools-backend/current/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/config/backend.env
ExecStart=/usr/bin/node src/chain-stream-listener.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-chain-stream-listener

[Install]
WantedBy=multi-user.target
