[Unit]
Description=BooneTools Financials history and live read-model collector
After=network-online.target docker.service boonetools-api.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/boonetools-backend/current/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/boonetools-backend/config/backend.env
StateDirectory=boonetools-financials
StateDirectoryMode=0750
Environment=FINANCIALS_CACHE_DIR=/var/lib/boonetools-financials
ExecStart=/usr/bin/node src/financials-collector.js
Restart=always
RestartSec=15
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boonetools-financials

[Install]
WantedBy=multi-user.target
