PORT=8787
DATABASE_URL=postgresql://boonetools:change-me@127.0.0.1:5433/boonetools
# Legacy optional client token. Public GET routes do not treat this as a secret.
PUBLIC_API_KEY=
BOONETOOLS_PROVIDER_CLIENT_ID=BooneTools
PROVIDER_COOLDOWN_ENABLED=true
PROVIDER_FAILURE_COOLDOWN_SECONDS=60
PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=3600
# Supported Liquify + NativeSwap reads share bounded process-local lanes.
# False restores ordered selection and serial collector batch windows.
THORCHAIN_PROVIDER_BALANCING_ENABLED=true
# Maximum active requests per gateway, per process (not a cross-process quota).
THORCHAIN_PROVIDER_CONCURRENCY=6
THORNODE_PRIMARY_URL=https://gateway.liquify.com/chain/thorchain_api
THORNODE_FALLBACK_URL=https://public-thornode.nativeswap.io
# Historical-height THORNode REST endpoint. Required for the Feb 2025 POL backfill.
THORNODE_ARCHIVE_URL=
# Five-minute aggregate used for per-validator Bifrost block-scanner lag.
BIFROST_SCANNER_INFO_URL=https://vanaheimex.com/api/nodesInfo
BIFROST_SCANNER_INFO_TIMEOUT_MS=8000
# Public Spot market-data endpoint; no Binance API key is required.
BINANCE_API_BASE_URL=https://data-api.binance.vision
# Optional ordered fallbacks, comma separated.
BINANCE_API_BASE_URLS=https://data-api.binance.vision
POOL_DISLOCATION_BACKFILL_REQUEST_DELAY_MS=100
POOL_DISLOCATION_BACKFILL_BATCH_BUCKETS=12
POOL_DISLOCATION_BACKFILL_RETRY_ATTEMPTS=8
POOL_DISLOCATION_BACKFILL_RETRY_BASE_DELAY_MS=1000
POOL_DISLOCATION_BACKFILL_RETRY_MAX_DELAY_MS=60000
# Empty uses Liquify then NativeSwap. Explicit lists replace both defaults.
POOL_DISLOCATION_THORNODE_URLS=
POOL_DISLOCATION_SNAPSHOT_RETRY_ATTEMPTS=3
POOL_DISLOCATION_SNAPSHOT_RETRY_BASE_DELAY_MS=1000
POOL_DISLOCATION_CORE_FALLBACK_MAX_AGE_SECONDS=180
POOL_DISLOCATION_TRADING_FALLBACK_MAX_AGE_SECONDS=900
POOL_DISLOCATION_REPAIR_LOOKBACK_HOURS=168
POOL_DISLOCATION_REPAIR_MAX_BUCKETS=24
POOL_DISLOCATION_REPAIR_RETRY_ATTEMPTS=4
POOL_DISLOCATION_REPAIR_RETRY_BASE_DELAY_MS=500
POOL_DISLOCATION_REPAIR_RETRY_MAX_DELAY_MS=10000
POOL_ANALYSIS_START_DATE=2021-04-01
POOL_ANALYSIS_RECENT_LOOKBACK_DAYS=35
POOL_ANALYSIS_REQUEST_DELAY_MS=100
POOL_ANALYSIS_MAX_PAGES=30
POOL_ANALYSIS_CONCURRENCY=2
POOL_ANALYSIS_HISTORY_REQUEST_LIMIT=20
POOL_ANALYSIS_CORE_MAX_AGE_MS=300000
# Burn keeps live five-minute updates and audits its historical total daily.
BURN_TRACKER_HISTORY_REQUEST_LIMIT=1
BURN_TRACKER_RECONCILE_INTERVAL_MS=86400000
# Optional ordered list; set a dedicated/provider endpoint first in production.
THORNODE_URLS=
MIDGARD_URL=https://gateway.liquify.com/chain/thorchain_midgard/v2
# Optional ordered list; set a dedicated/provider endpoint first in production.
# Liquify Portal URLs append /v2 to the supplied /api=<key> endpoint. Store the
# actual value only in the server-owned environment, never a VITE_* variable.
# Also replace any explicit RUJIRA_*_MIDGARD_URLS overrides during a cutover.
MIDGARD_URLS=
# Cross-process admission guard; these are our safety caps, not Liquify quotas.
# All /actions requests and Financials day acquisition consume the bulk subset.
# Enabled by default in production; requires migration 069. Denials preserve work.
MIDGARD_REQUEST_BUDGET_ENABLED=true
MIDGARD_REQUEST_BUDGET_TOTAL_MINUTE=60
MIDGARD_REQUEST_BUDGET_TOTAL_HOUR=2000
MIDGARD_REQUEST_BUDGET_TOTAL_DAY=20000
MIDGARD_REQUEST_BUDGET_BULK_MINUTE=30
MIDGARD_REQUEST_BUDGET_BULK_HOUR=1000
MIDGARD_REQUEST_BUDGET_BULK_DAY=5000
# Configured HTTPS Liquify Portal Midgard keys use a separate burst profile.
# Migration 070 adds shared cross-process pacing: 200ms = at most 5 admissions/s.
# Public endpoints retain the limits above. Existing counters are not reset.
MIDGARD_PORTAL_REQUEST_BUDGET_TOTAL_MINUTE=180
MIDGARD_PORTAL_REQUEST_BUDGET_BULK_MINUTE=60
MIDGARD_PORTAL_REQUEST_MIN_INTERVAL_MS=200
# Omit these to inherit the existing hourly/daily safety ceilings above.
# MIDGARD_PORTAL_REQUEST_BUDGET_TOTAL_HOUR=2000
# MIDGARD_PORTAL_REQUEST_BUDGET_TOTAL_DAY=20000
# MIDGARD_PORTAL_REQUEST_BUDGET_BULK_HOUR=1000
# MIDGARD_PORTAL_REQUEST_BUDGET_BULK_DAY=5000
# These controls do not track a provider's account-wide monthly billing quota.
RPC_REST_URL=https://gateway.liquify.com/chain/thorchain_rpc
RPC_FALLBACK_REST_URL=https://public-thorchain-rpc.nativeswap.io
# Empty uses Liquify then NativeSwap. Explicit lists replace both defaults.
RPC_REST_URLS=
# Historical block RPC used to map UTC day-end timestamps to heights.
RPC_ARCHIVE_REST_URL=https://rpc.thorchain.liquify.com
RPC_WS_URL=wss://gateway.liquify.com/chain/thorchain_rpc/websocket
POL_TRACKER_START_DATE=2025-02-01
# Ordered historical-height providers; configure the archive endpoint first.
POL_TRACKER_THORNODE_URLS=
# Empty retains the Liquify archive and gateway, then tries NativeSwap.
POL_TRACKER_RPC_URLS=
POL_TRACKER_LP_CONCURRENCY=4
