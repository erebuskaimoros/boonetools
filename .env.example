# BooneTools backend integration used by every frontend feature
VITE_BOONETOOLS_API_BASE=https://boone.tools/functions/v1

# Optional public client identifier. This value is browser-visible and is not
# an authentication secret; backend read endpoints are openly rate-limited.
VITE_BOONETOOLS_API_KEY=

# swap.thorchain.org widget affiliate key (issued at swap.thorchain.org/affiliate)
# for the footer [S] swap panel. Browser-visible by design. A nonempty key enables
# the launcher and shortcut; keep the actual value in ignored .env.local for dev.
VITE_STO_WIDGET_API_KEY=

# WalletConnect/Reown public project ID for THORWallet and other mobile wallets.
# Create an App project at https://dashboard.walletconnect.com/ and use its
# 32-character project ID. Empty disables WalletConnect. Keep the value in
# ignored .env.local for development; see docs/walletconnect.md for deployment.
VITE_WALLETCONNECT_PROJECT_ID=

# Legacy VITE_NODEOP_*, VITE_APP_LAYER_*, VITE_NODE_VOTES_*,
# VITE_RAPID_SWAPS_*, and VITE_TC_FEE_DASH_* API variables remain accepted
# during migration. Do not mix feature-specific origins or keys in new envs.
