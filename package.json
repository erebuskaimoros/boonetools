{
  "name": "svelte",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "node --test tests/**/*.test.js",
    "check": "npm run check:boundaries && npm run check:surface && npm run check:svelte",
    "check:boundaries": "node ./scripts/check-import-boundaries.mjs && node ./scripts/check-provider-boundaries.mjs",
    "check:surface": "node ./scripts/audit-frontend-surface.mjs --check",
    "check:svelte": "node ./scripts/check-svelte-diagnostics.mjs",
    "design:lint": "npx --yes @google/design.md@0.1.1 lint DESIGN.md",
    "perf:smoke": "node ./scripts/perf-smoke.mjs",
    "backend:test": "npm --prefix ./backend test",
    "boonetools:deploy:frontend": "bash ./scripts/deploy-boonetools-frontend.sh",
    "boonetools:deploy:backend": "bash ./scripts/deploy-boonetools-backend.sh",
    "nodeop:deploy:backend": "bash ./scripts/nodeop-backend-deploy.sh"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.3",
    "svelte-preprocess": "^6.0.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@scure/base": "1.2.6",
    "@tcswap/core": "^4.1.34",
    "@tcswap/helpers": "^4.5.26",
    "@tcswap/plugins": "^4.2.30",
    "@tcswap/wallets": "^4.3.34",
    "axios": "^1.20.0",
    "chalk": "^5.6.2",
    "chart.js": "^4.4.4",
    "chartjs-chart-sankey": "^0.14.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "echarts": "6.1.0",
    "ethers": "^6.13.4",
    "klinecharts": "^9.8.12",
    "postcss": "^8.5.31",
    "svelte-routing": "^2.13.0",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "overrides": {
    "axios": "$axios",
    "protobufjs": "^7.6.6",
    "@cardano-sdk/crypto": {
      "npm": "^11.21.1"
    },
    "bn.js@^5": "^5.2.5",
    "bs58@^4": "^4.0.1",
    "ajv@^8": "^8.20.0",
    "validator": "^13.15.35",
    "ws@^8": "^8.21.1",
    "ws@^7": "^7.5.11"
  }
}
